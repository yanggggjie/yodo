{
  "manifest_version": 3,
  "name": "yodo",
  "version": "0.1.0",
  "description": "yodo 的 Chrome 连接扩展：让 yodo 只操作它自己打开的标签页。",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
